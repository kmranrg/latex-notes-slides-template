% ==============================================================
%  mynotes.sty  --  style for research & lecture notes
%  White page, code-style font (IBM Plex Mono), colored boxes,
%  compact spacing, header & footer.  Compile with XeLaTeX.
%  Everything shared with the slides lives in mynotes-core.sty.
% ==============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mynotes}[2026/11/16 v1.0 Notes style]

% Option: \usepackage[classicmath]{mynotes} -- math letters in Latin Modern, not Plex Mono
\DeclareOption{classicmath}{\def\nb@classicmath{}}
\ProcessOptions\relax

% ================= Page layout (compact) =================
\RequirePackage[a4paper, top=2cm, bottom=2cm, left=1.8cm, right=1.8cm,
  headheight=14pt, headsep=10pt, footskip=22pt]{geometry}
\RequirePackage{parskip}
\setlength{\parskip}{4pt plus 1pt}
\linespread{1.12}

\RequirePackage{mynotes-core}

\AtBeginDocument{\RaggedRight\setlength{\RaggedRightParindent}{0pt}}
% Tighter space around displayed equations
\AtBeginDocument{%
  \setlength{\abovedisplayskip}{5pt plus 2pt}\setlength{\belowdisplayskip}{5pt plus 2pt}%
  \setlength{\abovedisplayshortskip}{2pt}\setlength{\belowdisplayshortskip}{3pt}}
\numberwithin{equation}{section}               % (1.5.1), (1.5.2), ...
\AtBeginDocument{\color{bodytext}}
\counterwithin{table}{section}                 % Table 1.1, Figure 1.1, ...
\counterwithin{figure}{section}
\setlength{\floatsep}{8pt plus 2pt}  \setlength{\textfloatsep}{8pt plus 2pt}
\setlength{\intextsep}{8pt plus 2pt}

% ================= Headings (compact) =================
\RequirePackage{etoolbox}
\RequirePackage{titlesec}
\titleformat{\section}{\color{accent}\Large\bfseries}{\thesection}{0.7em}{}
\titleformat{\subsection}{\color{accent}\large\bfseries}{\thesubsection}{0.7em}{}
\titleformat{\subsubsection}{\color{accent}\normalsize\bfseries}{}{0em}{}
\titlespacing*{\section}{0pt}{12pt}{4pt}
\titlespacing*{\subsection}{0pt}{9pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{6pt}{2pt}
\@ifundefined{chapter}{}{%
  \titleclass{\chapter}{straight}              % chapters don't force a new page...
  \titleformat{\chapter}{\color{accent}\huge\bfseries}{\thechapter}{0.6em}{}
  \titlespacing*{\chapter}{0pt}{0pt}{10pt}
  \preto\chapter{\clearpage}}                  % ...but do start on a fresh page, no gap

% ================= Lists =================
\RequirePackage{enumitem}
\setlist{itemsep=1pt, topsep=3pt, parsep=0pt}
\setlist[itemize]{label=\textcolor{accent}{\small\textbullet}, leftmargin=1.5em}
\setlist[enumerate]{leftmargin=1.8em}

% ================= Title, header & footer =================
% \notesetup{Short title}{Author}{URL}   (put in the preamble)
\newcommand{\notesetup}[3]{\gdef\nb@short{#1}\gdef\nb@author{#2}\gdef\nb@url{#3}}
\notesetup{Notes}{}{}
% Author name, linked to the website when one is given (footer)
\newcommand{\nb@authorlink}{\if\relax\detokenize\expandafter{\nb@url}\relax\nb@author
  \else\href{\nb@url}{\color{bodytext!65}\nb@author}\fi}
% \notetitle{Full title}   -- compact title block for a single note
\newcommand{\notetitle}[1]{%
  {\color{accent}\fontsize{22}{27}\selectfont\bfseries #1\par}\vspace{2pt}%
  {\small\color{bodytext!65}\if\relax\detokenize\expandafter{\nb@url}\relax\nb@author
    \else\href{\nb@url}{\nb@author}\fi\enspace|\enspace\today\par}%   (name links to website)
  \vspace{2pt}{\color{accent}\rule{\linewidth}{0.6pt}}\par\vspace{2pt}}

\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\fancypagestyle{notes}{%
  \fancyhf{}%
  \fancyhead[L]{\small\color{bodytext!65}\nb@short}%
  \fancyhead[R]{\small\color{bodytext!65}\nouppercase{\leftmark}}%
  \fancyfoot[L]{\small\color{bodytext!65}\nb@authorlink}%
  \fancyfoot[R]{\small\color{bodytext!65}Page \thepage\ of \pageref*{LastPage}}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\headrule}{\color{bodytext!30}\hrule width\headwidth height\headrulewidth}%
  \renewcommand{\footrulewidth}{0pt}}
\pagestyle{notes}
\AtBeginDocument{\pagestyle{notes}}
% First page of a chapter / title page uses the same style (no empty pages)
\RequirePackage{etoolbox}
% First page of the document and of each chapter: footer only, no header
\fancypagestyle{notesfirst}{\pagestyle{notes}\fancyhead{}\renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\headrule}{}}
\fancypagestyle{plain}{\pagestyle{notesfirst}}
\patchcmd{\chapter}{\thispagestyle{plain}}{\thispagestyle{notesfirst}}{}{}
\AtBeginDocument{\thispagestyle{notesfirst}}
\@ifundefined{chapter}%
  {\renewcommand{\sectionmark}[1]{\markboth{\thesection\enspace #1}{}}}%
  {\renewcommand{\chaptermark}[1]{\markboth{\thechapter\enspace #1}{}}}

\endinput
