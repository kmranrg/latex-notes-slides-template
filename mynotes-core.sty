% ================= Tables, figures, plots, algorithms =================
\RequirePackage{graphicx}
\RequirePackage{booktabs, tabularx, multirow}
\RequirePackage{needspace}
\RequirePackage{array}
\RequirePackage[font=small, labelfont={bf,color=accent}, skip=4pt]{caption}
\RequirePackage{subcaption}

\definecolor{tablehead}{RGB}{225,236,246}
\definecolor{tablestripe}{RGB}{246,248,250}
\newcommand{\thead}[1]{\textbf{#1}}            % header cell
\newcolumntype{L}{>{\RaggedRight\arraybackslash}X}   % wrapping left column
\newcolumntype{C}{>{\centering\arraybackslash}X}     % wrapping centered column

% Tables and figures below are NOT floats: they stay exactly where you write them
% (better for notes; they also work inside boxes and callouts).
\captionsetup[table]{position=top}
% \begin{datatable}[Caption][tab:label]{colspec}   first row = header, then striped rows
\NewDocumentEnvironment{datatable}{o o m}{%
  \par\needspace{6\baselineskip}\begin{center}
  \IfValueT{#1}{\captionof{table}{#1}\nobreak}\IfValueT{#2}{\label{#2}}%
  \setlength{\aboverulesep}{0pt}\setlength{\belowrulesep}{0pt}%
  \renewcommand{\arraystretch}{1.35}%
  \rowcolors{2}{tablestripe}{white}%
  \begin{tabular}{#3}\toprule\rowcolor{tablehead}%
}{\\\bottomrule\end{tabular}\end{center}}
% \begin{widetable}[Caption][tab:label]{colspec}   full width; use X / L / C columns to wrap
\NewDocumentEnvironment{widetable}{o o m}{%   (no center env here: tabularx needs
  \par\addvspace{6pt}\needspace{6\baselineskip}\noindent  % to see \end{widetable} directly)
  \IfValueT{#1}{\captionof{table}{#1}\nobreak}\IfValueT{#2}{\label{#2}}%
  \setlength{\aboverulesep}{0pt}\setlength{\belowrulesep}{0pt}%
  \renewcommand{\arraystretch}{1.35}%
  \rowcolors{2}{tablestripe}{white}%
  \tabularx{\linewidth}{#3}\toprule\rowcolor{tablehead}%
}{\toks@\expandafter{\the\toks@\\\bottomrule}\endtabularx\par\addvspace{6pt}}
% \begin{notefigure}[Caption][fig:label]  \includegraphics[...]{...}  \end{notefigure}
\NewDocumentEnvironment{notefigure}{o o}{\par\begin{center}\def\@captype{figure}}%  (subfigures work too)
  {\IfValueT{#1}{\par\captionof{figure}{#1}}\IfValueT{#2}{\label{#2}}\end{center}}

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18,
  every axis/.append style={grid=major, grid style={black!10},
    tick label style={font=\footnotesize}, label style={font=\small},
    legend style={font=\footnotesize, draw=none, fill=white}},
  cycle list={{accent, thick},{co-orange, thick},{co-green, thick},{co-red, thick}}}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\counterwithin{algorithm}{section}

% ================= Links & references =================
\RequirePackage{hyperref}
\hypersetup{colorlinks=true, linkcolor=accent, urlcolor=accent, citecolor=accent}
\RequirePackage[nameinlink,capitalize,noabbrev]{cleveref}

% ================= Boxes =================
\RequirePackage[most]{tcolorbox}
\tcbset{
  notebox/.style 2 args={
    enhanced, breakable,
    colback=#2, colframe=#1, coltext=bodytext,
    boxrule=0pt, leftrule=3.5pt, arc=2pt, outer arc=2pt,
    left=7pt, right=7pt, top=3pt, bottom=4pt,
    before skip=6pt, after skip=6pt, before upper=\RaggedRight,
    fonttitle=\bfseries, coltitle=white,
    attach boxed title to top left={yshift*=-\tcboxedtitleheight},
    boxed title style={colback=#1, boxrule=0pt, sharp corners,
                       left=5pt, right=5pt, top=2pt, bottom=2pt},
  }
}
\newcommand{\nb@title}[2]{#1~\thetcbcounter\if\relax\detokenize{#2}\relax\else\ \mdseries(#2)\fi}

% Usage:  \begin{definition}[Optional title][def:label] ... \end{definition}
%         both brackets optional; refer back with \cref{def:label}
\DeclareTColorBox[auto counter, number within=section,
  crefname={Definition}{Definitions}]{definition}{ O{} o }{%
  notebox={defframe}{defback}, title={\nb@title{Definition}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[auto counter, number within=section,
  crefname={Example}{Examples}]{example}{ O{} o }{%
  notebox={exframe}{exback}, title={\nb@title{Example}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[auto counter, number within=section,
  crefname={Theorem}{Theorems}]{theorem}{ O{} o }{%
  notebox={thmframe}{thmback}, title={\nb@title{Theorem}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[use counter from=theorem,
  crefname={Lemma}{Lemmas}]{lemma}{ O{} o }{%
  notebox={thmframe}{thmback}, title={\nb@title{Lemma}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[use counter from=theorem,
  crefname={Proposition}{Propositions}]{proposition}{ O{} o }{%
  notebox={thmframe}{thmback}, title={\nb@title{Proposition}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[use counter from=theorem,
  crefname={Corollary}{Corollaries}]{corollary}{ O{} o }{%
  notebox={thmframe}{thmback}, title={\nb@title{Corollary}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[auto counter, number within=section,
  crefname={Exercise}{Exercises}]{exercise}{ O{} o }{%
  notebox={exerframe}{exerback}, title={\nb@title{Exercise}{#1}}, IfValueT={#2}{label={#2}}}
\DeclareTColorBox[auto counter, number within=section,
  crefname={Remark}{Remarks}]{remark}{ O{} o }{%
  notebox={remframe}{remback}, title={\nb@title{Remark}{#1}}, IfValueT={#2}{label={#2}}}

% Proof / solution: thin gray bar on the left
\renewcommand{\qedsymbol}{\ensuremath{\blacksquare}}   % filled square
\let\proof\relax\let\endproof\relax
\newenvironment{proof}[1][\proofname]{%
  \begin{tcolorbox}[enhanced, breakable, blanker, borderline west={1pt}{0pt}{black!35},
                    left=8pt, before skip=2pt, after skip=6pt, before upper=\RaggedRight]%
  \textit{#1.}\ }{\qed\end{tcolorbox}}
\newif\ifshowsolutions \showsolutionstrue
\newenvironment{solution}{\ifshowsolutions\begin{proof}[Solution]}{\end{proof}\fi}


% ================= Code (Python & others) =================
\newfontfamily\nb@icons{FontAwesome6-Solid.otf}[Path = fonts/, BoldFont = FontAwesome6-Solid.otf]
\newcommand{\nb@icon}[1]{{\nb@icons\symbol{"#1}}}
\newfontfamily\nb@brands{FontAwesome6-Brands.otf}[Path = fonts/, BoldFont = FontAwesome6-Brands.otf]
\newcommand{\nb@brand}[1]{{\nb@brands\symbol{"#1}}}

\tcbuselibrary{listings}
\providecommand{\nb@codesize}{\small}           % beamer theme sets \footnotesize
\definecolor{codebg}{RGB}{246,248,250}
\definecolor{codeframe}{RGB}{208,215,222}
\definecolor{code-kw}{RGB}{175,0,219}        % keywords      (VS Code light)
\definecolor{code-fn}{RGB}{121,94,38}        % builtins
\definecolor{code-str}{RGB}{163,21,21}       % strings
\definecolor{code-com}{RGB}{0,128,0}         % comments
\definecolor{code-ln}{RGB}{150,150,150}      % line numbers

\lstdefinestyle{notes}{
  basicstyle=\ttfamily\nb@codesize, columns=fullflexible, keepspaces=true,
  keywordstyle=\color{code-kw}, keywordstyle=[2]\color{code-fn},
  stringstyle=\color{code-str}, commentstyle=\color{code-com}\itshape,
  numberstyle=\scriptsize\color{code-ln}, numbersep=8pt,
  showstringspaces=false, breaklines=true, tabsize=4,
  breakatwhitespace=false, postbreak=\mbox{$\hookrightarrow$\space},  % (no \color here: breaks in beamer)
  upquote=true}
\lstdefinestyle{py}{style=notes, language=Python,
  morekeywords={True,False,None,self,async,await,with,as,lambda,yield,nonlocal},
  morekeywords=[2]{print,len,range,enumerate,zip,map,filter,sum,min,max,abs,
    int,float,str,list,dict,set,tuple,isinstance,open,super,sorted,round}}


\tcbset{codebox/.style={
  enhanced, breakable, listing only,
  colback=codebg, colframe=codeframe, boxrule=0.5pt, arc=2pt,
  left=18pt, right=4pt, top=2pt, bottom=2pt, before skip=6pt, after skip=6pt,
  fonttitle=\ttfamily\small\bfseries, coltitle=bodytext!80,
  colbacktitle=codeframe!45, titlerule=0pt, toptitle=1pt, bottomtitle=1pt}}

% \begin{python}[optional title, e.g. a filename] ... \end{python}
\DeclareTCBListing{python}{ O{} }{codebox,
  listing options={style=py, numbers=left},
  \if\relax\detokenize{#1}\relax\else title={\nb@brand{F3E2}\enspace\detokenize{#1}},\fi}
% \begin{codeblock}{C++}[optional title] ... \end{codeblock}   (any listings language)
\DeclareTCBListing{codeblock}{ m O{} }{codebox,
  listing options={style=notes, language={#1}, numbers=left},
  title={\nb@icon{F121}\enspace\if\relax\detokenize{#2}\relax\detokenize{#1}\else\detokenize{#2}\fi}}
% \pyfile[optional title]{path/to/script.py}   -- include a whole file
\NewDocumentCommand{\pyfile}{ O{} m }{%
  \tcbinputlisting{codebox, listing file={#2},
    listing options={style=py, numbers=left},
    title={\nb@brand{F3E2}\enspace\if\relax\detokenize{#1}\relax\detokenize{#2}\else #1\fi}}}
% \begin{terminal} ... \end{terminal}   -- program output / shell
\DeclareTCBListing{terminal}{ O{Output} }{codebox,
  colback=black!85, colframe=black!85, colbacktitle=black!70, coltitle=white,
  left=6pt, listing options={style=notes, basicstyle=\ttfamily\nb@codesize\color{white}},
  title={\nb@icon{F120}\enspace #1}}
% Inline code:  \code{x_1 = np.zeros(3)}   (works everywhere, also in tables & titles;
% braces must be balanced; write \% and \# for % and #)
\ExplSyntaxOn
\tl_new:N \l__nb_code_tl
\cs_new_protected:Npn \nb_code:n #1
  {
    \tl_set:Nx \l__nb_code_tl { \tl_to_str:n {#1} }
    % \detokenize puts a space after every \command: undo it unless a letter or \ follows
    \regex_replace_all:nnN { (\\[A-Za-z@]+)\x{20}([^A-Za-z\\\x{20}]) } { \1\2 } \l__nb_code_tl
    \regex_replace_all:nnN { (\\[A-Za-z@]+)\x{20}\Z } { \1 } \l__nb_code_tl
    \regex_replace_all:nnN { \#\# } { \# } \l__nb_code_tl
    \regex_replace_all:nnN { \\([\%\#\&\_]) } { \1 } \l__nb_code_tl
    \tl_use:N \l__nb_code_tl
  }
\NewDocumentCommand{\code}{m}{{\setlength{\fboxsep}{1.5pt}%
  \colorbox{codebg}{\ttfamily\small\nb_code:n{#1}}}}
\ExplSyntaxOff

