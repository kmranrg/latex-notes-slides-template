% ================= Obsidian-style callouts =================
% Usage:  \begin{warning} ... \end{warning}
%         \begin{tip}[Custom title] ... \end{tip}
% Types:  note, info, todo, tip, hint, important, summary, tldr, success,
%         question, faq, warning, caution, attention, failure, danger, bug, quotebox

\newtcolorbox{nb@callout}[3]{% #1 color, #2 icon code, #3 title
  enhanced, breakable,
  colback=#1!7!white, coltext=bodytext,
  frame hidden, borderline west={3pt}{0pt}{#1}, arc=2pt,
  left=7pt, right=7pt, top=4pt, bottom=4pt,
  before skip=6pt, after skip=6pt,
  before upper={\RaggedRight{\color{#1}\bfseries\nb@icon{#2}\enspace #3}\par\vspace{1pt}}}

% (\DeclareDocumentEnvironment: e.g. unicode-math already defines \danger as a symbol)
% \newcallout{env name}{color}{icon hex code}{default title}
\newcommand{\newcallout}[4]{%
  \DeclareDocumentEnvironment{#1}{O{#4}}{\begin{nb@callout}{#2}{#3}{##1}}{\end{nb@callout}}}
% Defined at \begin{document}, after unicode-math sets up its symbols (\danger is one)
\AtBeginDocument{%
  \newcallout{note}{co-blue}{F304}{Note}%
  \newcallout{info}{co-blue}{F05A}{Info}%
  \newcallout{todo}{co-blue}{F058}{Todo}%
  \newcallout{tip}{co-cyan}{F06D}{Tip}%
  \newcallout{hint}{co-cyan}{F0EB}{Hint}%
  \newcallout{important}{co-cyan}{F06A}{Important}%
  \newcallout{summary}{co-cyan}{F46D}{Summary}%
  \newcallout{tldr}{co-cyan}{F46D}{TL;DR}%
  \newcallout{success}{co-green}{F00C}{Success}%
  \newcallout{question}{co-orange}{F059}{Question}%
  \newcallout{faq}{co-orange}{F059}{FAQ}%
  \newcallout{warning}{co-orange}{F071}{Warning}%
  \newcallout{caution}{co-orange}{F071}{Caution}%
  \newcallout{attention}{co-orange}{F071}{Attention}%
  \newcallout{failure}{co-red}{F00D}{Failure}%
  \newcallout{danger}{co-red}{F0E7}{Danger}%
  \newcallout{bug}{co-red}{F188}{Bug}%
  \newcallout{quotebox}{co-gray}{F10D}{Quote}%
}

