\definecolor{exframe}{RGB}{25,118,210}    \definecolor{exback}{RGB}{240,246,252}
\definecolor{thmframe}{RGB}{142,36,36}    \definecolor{thmback}{RGB}{251,238,238}
\definecolor{remframe}{RGB}{110,110,110}  \definecolor{remback}{RGB}{245,245,245}
\definecolor{exerframe}{RGB}{180,95,6}    \definecolor{exerback}{RGB}{254,245,231}
\definecolor{hlcolor}{RGB}{255,232,150}
\definecolor{co-blue}{RGB}{8,109,221}
\definecolor{co-cyan}{RGB}{0,160,158}
