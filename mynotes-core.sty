% ==============================================================
%  mynotes-core.sty  --  shared by notes (mynotes.sty) and slides
%  (beamerthememynotes.sty): fonts, colors, boxes, callouts, code,
%  tables, figures, macros. You normally never load this directly.
% ==============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mynotes-core}[2026/11/16 v1.0 Shared core of mynotes]

\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{mynotes}{Compile with XeLaTeX or LuaLaTeX, not pdfLaTeX}
    {Add  % !TEX program = xelatex  as the first line of your main file.}
\fi

% ================= Fonts =================
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{etoolbox}
\RequirePackage{fontspec}
\setmainfont{IBMPlexMono}[
  Path = fonts/, Extension = .ttf,
  UprightFont = *-Regular, BoldFont = *-Bold,
  ItalicFont = *-Italic, BoldItalicFont = *-BoldItalic]
\setsansfont{IBMPlexMono}[
  Path = fonts/, Extension = .ttf,
  UprightFont = *-SemiBold, BoldFont = *-Bold,
  ItalicFont = *-Italic, BoldItalicFont = *-BoldItalic]
\setmonofont{IBMPlexMono}[
  Path = fonts/, Extension = .ttf,
  UprightFont = *-Regular, BoldFont = *-Bold]
\RequirePackage{unicode-math}
\setmathfont{latinmodern-math.otf}[Scale=1.12]  % match Plex Mono's tall letters
% Math letters and digits in Plex Mono, to match the text. Latin Modern Math
% still gives symbols, operators, big integrals/sums and Greek.
% Option classicmath (\usepackage[classicmath]{mynotes} or
% \usetheme[classicmath]{mynotes}) keeps all-Latin-Modern math.
\ifdefined\nb@classicmath\else
  \setmathfont{IBMPlexMono-Italic.ttf}[Path=fonts/, range=it/{latin,Latin}]
  \setmathfont{IBMPlexMono-Regular.ttf}[Path=fonts/, range=up/{latin,Latin,num}]
  \setmathfont{IBMPlexMono-Bold.ttf}[Path=fonts/, range=bfup/{latin,Latin,num}]
  \setmathfont{IBMPlexMono-BoldItalic.ttf}[Path=fonts/, range=bfit/{latin,Latin}]
\fi
\RequirePackage{ragged2e}                      % monospace looks best ragged-right
% Monospace spaces cannot stretch: without this, a line ending in an inline
% code box can stick out into the margin instead of breaking earlier.
\setlength{\emergencystretch}{3em}

